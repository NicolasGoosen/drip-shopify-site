{%- comment -%}
  APEX closing CTA banner.

  Desktop, as drawn: a wide full-bleed photograph with the copy in a left
  column, vertically centred, and a solid white button.

  Mobile is not in the mockups and was decided here: the copy bottom-anchors
  over the photograph and the band grows with its content instead of holding a
  fixed height. That is the same treatment the hero already uses on mobile, so
  the two full-bleed photographic bands behave alike rather than each inventing
  their own rule.

  The scrim changes direction rather than strength between breakpoints — it
  runs to the right on desktop, where the copy occupies the left half, and
  upward on mobile, where the copy sits along the bottom edge. One gradient,
  one opacity control, direction swapped through a custom property.
{%- endcomment -%}

{%- liquid
  assign img = section.settings.image
  assign banner_alt = img.alt | default: section.settings.heading
-%}

<section
  class="cta-banner"
  style="
    --cta-min-h: {{ section.settings.min_height }}px;
    --cta-scrim: {{ section.settings.scrim_opacity | divided_by: 100.0 }};
  "
>
  <div class="cta-banner__media">
    {%- if img != blank -%}
      {{
        img
        | image_url: width: 3000
        | image_tag:
          loading: 'lazy',
          sizes: '100vw',
          widths: '600, 900, 1200, 1600, 2000, 2600, 3000',
          class: 'cta-banner__image',
          alt: banner_alt
      }}
    {%- else -%}
      {%- comment -%}
        Falls back to a file uploaded under Content > Files. width/height are
        the box, not the file — a filename carries no intrinsic dimensions and
        object-fit: cover makes the pair a pre-stylesheet reservation only.
      {%- endcomment -%}
      <img
        class="cta-banner__image"
        src="{{ section.settings.fallback_image_name | file_url }}"
        alt="{{ section.settings.heading | escape }}"
        width="2400"
        height="1600"
        loading="lazy"
      >
    {%- endif -%}
  </div>

  <div class="apex-container cta-banner__inner">
    <div class="cta-banner__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cta-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="cta-banner__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="cta-banner__body">{{ section.settings.body | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a
          class="btn btn-light cta-banner__cta"
          {% if section.settings.cta_link != blank %}
            href="{{ section.settings.cta_link }}"
          {% else %}
            href="{{ routes.all_products_collection_url }}"
          {% endif %}
        >
          {{ section.settings.cta_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cta-banner {
    --cta-scrim-dir: to top;

    position: relative;
    display: flex;
    isolation: isolate;
    background-color: var(--color-bg);
  }

  .cta-banner__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cta-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-banner__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      var(--cta-scrim-dir),
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 55%, transparent) 50%,
      transparent 100%
    );
    opacity: var(--cta-scrim, 0.7);
  }

  .cta-banner__inner {
    display: flex;
    /* Mobile: copy sits along the bottom edge, matching the hero. */
    align-items: flex-end;
    padding-block: var(--space-2xl) var(--space-lg);
  }

  .cta-banner__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    width: 100%;
  }

  .cta-banner__eyebrow {
    margin: 0;
    color: var(--brand-accent);
    font-family: var(--font-eyebrow);
    font-size: var(--text-xs);
    font-style: italic;
    font-weight: var(--weight-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  /* --text-h2 rather than --text-display: the mockup sets this at ~51px, which
     is the H2, not the 64px hero statement. --tracking-display carries the
     documented H2 behaviour — 0.01em on mobile opening to 0.06em on desktop —
     which is what lets a 48px heading hold its size on a 390px viewport. */
  .cta-banner__heading {
    max-width: 16ch;
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    text-transform: uppercase;
  }

  .cta-banner__body {
    max-width: 34ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .cta-banner__cta {
    margin-block-start: var(--space-2xs);
  }

  /* --- desktop ----------------------------------------------------------
     Fixed minimum height, copy vertically centred in a left column, scrim
     turned through 90 degrees to protect that column instead of the base. */

  @media screen and (min-width: 990px) {
    .cta-banner {
      --cta-scrim-dir: to right;

      min-height: var(--cta-min-h, 35.2rem);
    }

    .cta-banner__inner {
      align-items: center;
      padding-block: var(--space-xl);
    }

    .cta-banner__content {
      gap: var(--space-md);
      width: auto;
      max-width: 52rem;
    }

    .cta-banner__eyebrow {
      font-size: var(--text-h4);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "APEX CTA banner",
  "tag": "section",
  "class": "apex-cta-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Recommended: 2600px wide or more. Falls back to the file named below if empty."
    },
    {
      "type": "text",
      "id": "fallback_image_name",
      "label": "Fallback file name",
      "info": "A file uploaded under Content > Files. Used only when no image is picked above.",
      "default": "photoshoot-1.jpg"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Darken behind copy",
      "default": 70
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 240,
      "max": 640,
      "step": 8,
      "unit": "px",
      "label": "Minimum height, desktop",
      "info": "Mobile ignores this and grows with the copy.",
      "default": 352
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Play true."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered perfection."
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body",
      "default": "Ready for your next game?"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Apex 48"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Defaults to the all-products collection when empty."
    }
  ],
  "presets": [
    {
      "name": "APEX CTA banner"
    }
  ]
}
{% endschema %}
