{%- comment -%}
  APEX testimonials.

  Desktop, as drawn: bronze eyebrow above three quote columns. Each quote is a
  figure — blockquote plus figcaption — so the attribution is programmatically
  tied to the words rather than just sitting near them.

  Mobile is not in the mockups and was decided here: the three stack in one
  column, left-aligned, keeping the avatar-beside-name attribution row intact.
  A swipeable carousel was the alternative and was rejected — the mockup gives
  no scroll affordance to copy, and CLAUDE.md says not to invent behaviour a
  static mockup cannot show.

  The quote marks are bronze and decorative. They are pseudo-element content
  with an empty alt string, so a screen reader reads the sentence rather than
  announcing "left double quotation mark" around every quote. The opening mark
  hangs in the blockquote's start padding, which is how the mockup sets it.
{%- endcomment -%}

<section
  class="testimonials"
  style="
    --tm-bg: {{ section.settings.background }};
    --tm-pad-block: {{ section.settings.padding_block }}px;
    --tm-avatar: {{ section.settings.avatar_size }}px;
    --tm-cols: {{ section.blocks.size | at_most: 3 | at_least: 1 }};
  "
>
  <div class="apex-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="testimonials__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="testimonials__list" role="list">
        {%- for block in section.blocks -%}
          <li class="testimonials__item" {{ block.shopify_attributes }}>
            <figure class="testimonial">
              {%- if block.settings.quote != blank -%}
                <blockquote class="testimonial__quote">{{ block.settings.quote | escape }}</blockquote>
              {%- endif -%}

              <figcaption class="testimonial__person">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 200
                    | image_tag:
                      loading: 'lazy',
                      widths: '100, 150, 200',
                      sizes: '100px',
                      class: 'testimonial__avatar',
                      alt: block.settings.name
                  }}
                {%- endif -%}

                <span class="testimonial__meta">
                  {%- if block.settings.name != blank -%}
                    <span class="testimonial__name">{{ block.settings.name | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.rating != blank -%}
                    <span class="testimonial__rating">{{ block.settings.rating | escape }}</span>
                  {%- endif -%}
                </span>
              </figcaption>
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .testimonials {
    padding-block: var(--tm-pad-block, var(--space-section));
    background-color: var(--tm-bg, var(--color-bg-alt));
  }

  .testimonials__eyebrow {
    margin: 0 0 var(--space-lg);
    color: var(--brand-accent);
    font-family: var(--font-eyebrow);
    font-size: var(--text-xs);
    font-style: italic;
    font-weight: var(--weight-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .testimonials__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--grid-gap-row);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* --- one quote -------------------------------------------------------- */

  .testimonial {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
    margin: 0;
  }

  .testimonial__quote {
    position: relative;
    max-width: 34ch;
    margin: 0;
    /* Start padding is the opening mark's hanging column. */
    padding-inline-start: var(--space-sm);
    color: var(--color-text);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .testimonial__quote::before,
  .testimonial__quote::after {
    color: var(--brand-accent);
    font-size: var(--text-lead);
    line-height: 1;
  }

  /* `content: '…' / ''` supplies an empty accessible name, so the mark is
     drawn but not announced. */
  .testimonial__quote::before {
    content: '\201C' / '';
    position: absolute;
    inset-block-start: 5px;
    inset-inline-start: 10px;
  }

  .testimonial__quote::after {
    content: '\201D' / '';
    margin-inline-start: 0.15em;
  }

  /* --- attribution ------------------------------------------------------
     `margin-block-start: auto` pins the attribution to the bottom of the
     column, so all three line up even when one quote runs a line longer. */

  .testimonial__person {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding-inline-start: var(--space-sm);
  }

  .testimonial__avatar {
    flex: none;
    width: var(--tm-avatar, 4.8rem);
    height: var(--tm-avatar, 4.8rem);
    border-radius: var(--radius-pill);
    object-fit: cover;
  }

  .testimonial__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-unit);
    min-width: 0;
  }

  .testimonial__name {
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .testimonial__rating {
    color: var(--brand-accent);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  /* --- desktop ---------------------------------------------------------- */

  @media screen and (min-width: 750px) {
    .testimonials__eyebrow {
      font-size: var(--text-h4);
    }
  }

  @media screen and (min-width: 990px) {
    /* Track count follows the block count so two quotes fill the row instead
       of leaving a third column empty. Capped at 3 — beyond that the grid
       wraps onto a second row, as before. */
    .testimonials__list {
      grid-template-columns: repeat(var(--tm-cols, 3), minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "APEX testimonials",
  "tag": "section",
  "class": "apex-testimonials-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trusted by players"
    },
    {
      "type": "range",
      "id": "avatar_size",
      "min": 32,
      "max": 88,
      "step": 4,
      "unit": "px",
      "label": "Avatar size",
      "default": 48
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#151114"
    },
    {
      "type": "range",
      "id": "padding_block",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "Quotation marks are drawn by the theme — do not type them.",
          "default": "APEX 48 plays true every time. The flight, the bounce—so consistent. It just feels right."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Jordan W."
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating",
          "info": "Shown in bronze under the name.",
          "default": "4.5 DUPR"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Avatar",
          "info": "Square crop. The avatar is hidden if left empty."
        }
      ]
    }
  ],
  "presets": [
