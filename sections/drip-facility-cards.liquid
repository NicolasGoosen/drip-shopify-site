          "type": "tier",
          "settings": {
            "tier_name": "Gold",
            "tier_tone": "gold",
            "price": "$865.39",
            "price_suffix": "/quarter",
            "description": "For busy clubs and high-volume venues.",
            "features": "300 balls for your courts\n420 balls for your pro shop\nPotential retail revenue: $899.40",
            "pack_note": "30 × 4-packs + 30 × 10-packs",
            "featured": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
