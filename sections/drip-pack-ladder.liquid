{%- comment -%}
  DRIP pack ladder — the range, drawn as an ascending step chart.

  WHAT IT IS FOR
  A retailer's first question is not "is the ball good", it is "does one brand
  cover my whole counter". This draws the four pack sizes as four rising bars,
  so that answer is legible before a word is read.

  BAR LENGTH IS ORDINAL, NOT PROPORTIONAL
  Scaled to the ball count, the 4-pack would be 1.3% of the 300 and render as
  a hairline. Each step therefore carries its own `fill` percentage as a
  setting, defaulting to an even 25/50/75/100 climb. It is a rank device, not
  a chart — it should not be "fixed" by deriving the width from the numeral.

  REFLOW
  Mobile  — bars lie horizontally, growing left to right down the stack.
  >=750px — bars stand vertically in a row, growing left to right.
  The two are the same idea rotated; nothing is hidden at either width.

  MOTION
  Deliberately static. A scroll-triggered climb is the obvious embellishment
  and is in no mockup — see "Ask, don't guess" in CLAUDE.md.
{%- endcomment -%}

<section
  class="ladder"
  style="
    --ladder-bg: {{ section.settings.background }};
    --ladder-pad-block: {{ section.settings.padding_block }}px;
    --ladder-track: {{ section.settings.bar_height }}px;
  "
>
  <div class="drip-container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="ladder__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ladder__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ladder__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="ladder__steps" role="list">
        {%- for block in section.blocks -%}
          <li
            class="ladder__step"
            style="--step-fill: {{ block.settings.fill }}%;"
            {{ block.shopify_attributes }}
          >
            <div class="ladder__copy">
              {%- if block.settings.numeral != blank -%}
                <p class="ladder__numeral">{{ block.settings.numeral | escape }}</p>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <h3 class="ladder__label">{{ block.settings.label | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="ladder__buyer">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .ladder {
    padding-block: var(--ladder-pad-block, var(--space-section));
    background-color: var(--ladder-bg, var(--color-bg));
  }

  .ladder__head {
    display: grid;
    gap: var(--space-2xs);
    margin-block-end: var(--space-xl);
  }

  .ladder__eyebrow {
    margin: 0;
    color: var(--brand-accent);
    font-family: var(--font-eyebrow);
    font-size: var(--text-xs);
    font-style: italic;
    font-weight: var(--weight-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .ladder__heading {
    margin: 0;
    max-width: 20ch;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    text-transform: uppercase;
  }

  .ladder__steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* --- mobile: bars lie down -------------------------------------------- */

  .ladder__bar {
    display: block;
    inline-size: 100%;
    block-size: var(--space-2xs);
    margin-block-end: var(--space-xs);
    background-color: var(--brand-accent-wash);
  }

  .ladder__fill {
    display: block;
    inline-size: var(--step-fill, 100%);
    block-size: 100%;
    background-color: var(--brand-accent);
  }

  .ladder__copy {
    display: grid;
    gap: var(--space-2xs);
  }

  .ladder__numeral {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }

  .ladder__label {
    margin: 0;
    color: var(--brand-accent);
    font-family: var(--font-eyebrow);
    font-size: var(--text-xs);
    font-style: italic;
    font-weight: var(--weight-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .ladder__buyer {
    margin: 0;
    max-width: 34ch;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  .ladder__footnote {
    margin: var(--space-xl) 0 0;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  /* --- >=750px: bars stand up -------------------------------------------

     The bar track is a fixed block-size so all four steps share one baseline,
     and the fill grows from the bottom of it. Copy sits beneath the track, so
     the numerals line up too, however tall each fill is. */

  @media screen and (min-width: 750px) {
    .ladder__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      row-gap: var(--space-xl);
    }

    .ladder__bar {
      display: flex;
      align-items: flex-end;
      inline-size: var(--space-2xs);
      block-size: var(--ladder-track, 180px);
      margin-block-end: var(--space-sm);
    }

    .ladder__fill {
      inline-size: 100%;
      block-size: var(--step-fill, 100%);
    }
  }

  @media screen and (min-width: 990px) {
    .ladder__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DRIP pack ladder",
  "tag": "section",
  "class": "drip-pack-ladder-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Draws the pack range as ascending bars. Bar length is set per step below — it ranks the steps, it does not plot the ball count."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The range" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One ball. Four ways to sell it."
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Wholesale pricing available to approved partners at every tier."
    },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "background", "label": "Background", "default": "#151114" },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar track height (desktop)",
      "min": 80,
      "max": 320,
      "step": 20,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 32,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "numeral", "label": "Numeral", "default": "4" },
        { "type": "text", "id": "label", "label": "Label", "default": "4-pack" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Who buys it",
          "default": "The counter buy. Grab-and-go, gifting, first-time players."
        },
        {
          "type": "range",
          "id": "fill",
          "label": "Bar length",
          "min": 10,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 25
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DRIP pack ladder",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "numeral": "4",
            "label": "4-pack",
            "text": "The counter buy. Grab-and-go, gifting, first-time players.",
            "fill": 25
          }
        },
        {
          "type": "step",
          "settings": {
            "numeral": "50",
            "label": "50-ball",
            "text": "The league player and the coach running weekly sessions.",
            "fill": 50
          }
        },
        {
          "type": "step",
          "settings": {
            "numeral": "100",
            "label": "100-ball",
            "text": "Clubs, academies and pro shops restocking court baskets.",
            "fill": 75
          }
        },
        {
          "type": "step",
          "settings": {
            "numeral": "300",
            "label": "300-ball",
            "text": "Facilities, tournaments and regional programs buying by the season.",
            "fill": 100
          }
        }
      ]
    }
  ]
}
{% endschema %}
