{%- comment -%}
  DRIP collection product grid.

  A fork of Dawn's `main-collection-product-grid`, narrowed to what this
  catalogue actually uses (horizontal or drawer filters, no quick-add, no
  image shapes, no vendor/rating) and rendering `drip-card-product` on the
  dark ground instead of Dawn's light-surface card.

  DO NOT RENAME OR RESTRUCTURE THE WRAPPERS. facets.js does section rendering
  by id and swaps innerHTML in place; it hard-depends on all of:

    #ProductGridContainer      the swapped subtree
    .collection inside it      gets .loading during a fetch
    #product-grid[data-id]     supplies the section id for the render request
    #ProductCount / #ProductCountDesktop
    .facets-container, facet-filters-form, #FacetFiltersFormMobile

  Everything above is reproduced verbatim from Dawn. Only the contents of each
  <li> and the grid's own class list are ours. Styling for all of it lives in
  assets/drip-collection.css, scoped to .template-collection.

  Vertical filters are deliberately not carried over: the layout puts a
  ~250px sidebar beside the grid, which at this catalogue size would leave
  two cards on a row next to a mostly-empty rail. Horizontal is the default
  and drawer is the mobile fallback Dawn already uses below 750.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --acg-pad-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    --acg-pad-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    --acg-cols: {{ section.settings.columns_mobile }};
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --acg-pad-top: {{ section.settings.padding_top }}px;
      --acg-pad-bottom: {{ section.settings.padding_bottom }}px;
      --acg-cols: {{ section.settings.columns_desktop | at_most: 3 }};
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} {
      --acg-cols: {{ section.settings.columns_desktop }};
    }
  }
{%- endstyle -%}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="drip-cgrid">
    {%- paginate collection.products by section.settings.products_per_page -%}
      <div>
        {{ 'component-facets.css' | asset_url | stylesheet_tag }}
        <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <aside
            aria-labelledby="verticalTitle"
            class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %} page-width"
            id="main-collection-filters"
            data-id="{{ section.id }}"
          >
            {% render 'facets',
              results: collection,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting,
              filter_type: section.settings.filter_type,
              paginate: paginate
            %}
          </aside>
        {%- endif -%}

        <div class="product-grid-container" id="ProductGridContainer">
          {%- if collection.products.size == 0 -%}
            <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay gradient"></div>
              <div class="drip-cgrid__empty">
                <p class="drip-cgrid__empty-title">{{ 'sections.collection_template.empty' | t }}</p>
                <p class="drip-cgrid__empty-body">
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: collection.url, class: 'drip-cgrid__empty-link'
                  }}
                </p>
              </div>
            </div>
          {%- else -%}
            <div class="collection page-width">
              <div class="loading-overlay gradient"></div>

              <ul
                id="product-grid"
                data-id="{{ section.id }}"
                class="drip-pgrid"
                role="list"
              >
                {%- for product in collection.products -%}
                  {%- assign lazy_load = true -%}
                  {%- if forloop.index <= 4 -%}
                    {%- assign lazy_load = false -%}
                  {%- endif -%}
                  <li class="drip-pgrid__item">
                    {% render 'drip-card-product',
                      card_product: product,
                      lazy_load: lazy_load,
                      cta_label: section.settings.cta_label
                    %}
                  </li>
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</collection-component>

{% schema %}
{
  "name": "DRIP product grid",
  "class": "drip-cgrid-section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ]
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Card button label",
      "default": "Shop now"
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering",
      "info": "Filters are managed in Search & Discovery."
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "drawer", "label": "Drawer" }
      ],
      "default": "horizontal",
      "label": "Desktop filter layout"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 128
    }
  ]
}
{% endschema %}
