          "options": [
            { "value": "medal", "label": "Medal" },
            { "value": "shield-check", "label": "Shield" },
            { "value": "trophy", "label": "Trophy" },
            { "value": "indoor-outdoor", "label": "Indoor / outdoor" },
            { "value": "target", "label": "Target" },
            { "value": "value-props-icon-ball-design", "label": "Ball design" },
            { "value": "usap-approved", "label": "USA Pickleball approved" }
          ],
          "default": "indoor-outdoor"
        },
        { "type": "text", "id": "label_3", "label": "Label 3", "default": "Indoor & outdoor play" },
        {
          "type": "select",
          "id": "icon_4",
          "label": "Icon 4",
          "options": [
            { "value": "medal", "label": "Medal" },
            { "value": "shield-check", "label": "Shield" },
            { "value": "trophy", "label": "Trophy" },
