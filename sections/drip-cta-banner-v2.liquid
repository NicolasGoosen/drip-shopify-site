{%- comment -%}
  DRIP CTA banner v2.

  The same full-bleed photographic band as `drip-cta-banner`, rebuilt around a
  GRAPHIC rather than a headline. Everything about the media layer — the
  cover image, the scrim, the minimum height — behaves as it does in v1; what
  changes is what sits on top of it and how that block is placed.

  Placement, and the two ways it differs from v1:

    Left-aligned inside the container. The graphic starts at the same page
    gutter every other band starts at, so it lines up with the copy above and
    below it rather than floating.

    Vertically centred at BOTH breakpoints. v1 bottom-anchors its copy on
    mobile, which is right for a stack of text that wants to sit in the dark
    lower third of a photograph. A single mark centres — bottom-anchoring one
    object just reads as a mistake.

  Text is optional here, and blank by default. Every text field still exists
  and still renders when filled, stacked beneath the graphic — but the section
  is designed to hold nothing but the mark, and it composes correctly that way.

  Two ways to supply the graphic, because Shopify's image picker will not
  offer you an SVG:

    Graphic file — a file uploaded under Content > Files, addressed by name.
    This is the SVG route, and the one to use.

    Graphic image — the picker, for a PNG or JPG. It gets a responsive srcset
    and a reserved box, which the file route cannot have: a filename carries
    no dimensions, so nothing can be known about the artwork before it lands.

  The scrim runs to the right at both breakpoints rather than turning through
  90 degrees the way v1's does, because the thing it is protecting is in the
  left column at both breakpoints.
{%- endcomment -%}

{%- liquid
  assign img = section.settings.image
  assign banner_alt = img.alt | default: section.settings.heading

  assign graphic = section.settings.graphic_image
  assign has_graphic_image = false
  if graphic != blank
    assign has_graphic_image = true
  endif

  comment
    An empty alt is the CORRECT alt for a mark that repeats something the page
    already says — a logo above a "Shop Drip" button, say. It is the wrong one
    for a graphic carrying the only message in the band, which is why this is a
    field and not an assumption.
  endcomment
  assign graphic_alt = section.settings.graphic_alt

  assign has_text = false
  if section.settings.eyebrow != blank
    assign has_text = true
  endif
  if section.settings.heading != blank
    assign has_text = true
  endif
  if section.settings.body != blank
    assign has_text = true
  endif
  if section.settings.cta_label != blank
    assign has_text = true
  endif
-%}

<section
  class="cta-banner-v2"
  style="
    --ctav2-min-h-mobile: {{ section.settings.min_height_mobile }}px;
    --ctav2-min-h: {{ section.settings.min_height }}px;
    --ctav2-scrim: {{ section.settings.scrim_opacity | divided_by: 100.0 }};
    --ctav2-graphic-w-mobile: {{ section.settings.graphic_width_mobile }}px;
    --ctav2-graphic-w: {{ section.settings.graphic_width }}px;
  "
>
  <div class="cta-banner-v2__media">
    {%- if img != blank -%}
      {{
        img
        | image_url: width: 3000
        | image_tag:
          loading: 'lazy',
          sizes: '100vw',
          widths: '600, 900, 1200, 1600, 2000, 2600, 3000',
          class: 'cta-banner-v2__image',
          alt: banner_alt
      }}
    {%- else -%}
      {%- comment -%}
        Falls back to a file uploaded under Content > Files. width/height are
        the box, not the file — a filename carries no intrinsic dimensions and
        object-fit: cover makes the pair a pre-stylesheet reservation only.
      {%- endcomment -%}
      <img
        class="cta-banner-v2__image"
        src="{{ section.settings.fallback_image_name | file_url }}"
        alt="{{ section.settings.heading | escape }}"
        width="2400"
        height="1600"
        loading="lazy"
      >
    {%- endif -%}
  </div>

  <div class="drip-container cta-banner-v2__inner">
    <div class="cta-banner-v2__content">
      {%- if has_graphic_image -%}
        {{
          graphic
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 990px) 40rem, 80vw',
            widths: '200, 300, 400, 600, 800, 1200',
            class: 'cta-banner-v2__graphic',
            alt: graphic_alt
        }}
      {%- elsif section.settings.graphic_file_name != blank -%}
        <img
          class="cta-banner-v2__graphic"
          src="{{ section.settings.graphic_file_name | file_url }}"
          alt="{{ graphic_alt | escape }}"
          width="1200"
          height="800"
          loading="lazy"
        >
      {%- endif -%}

      {%- if has_text -%}
        <div class="cta-banner-v2__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="cta-banner-v2__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="cta-banner-v2__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <p class="cta-banner-v2__body">{{ section.settings.body | escape }}</p>
          {%- endif -%}

          {%- if section.settings.cta_label != blank -%}
            <a
              class="btn btn-light cta-banner-v2__cta"
              {% if section.settings.cta_link != blank %}
                href="{{ section.settings.cta_link }}"
              {% else %}
                href="{{ routes.all_products_collection_url }}"
              {% endif %}
            >
              {{ section.settings.cta_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cta-banner-v2 {
    position: relative;
    display: flex;
    min-height: var(--ctav2-min-h-mobile, 32rem);
    isolation: isolate;
    background-color: var(--color-bg);
  }

  .cta-banner-v2__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cta-banner-v2__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Runs to the right at both breakpoints — see the note at the top. */
  .cta-banner-v2__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to right,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 55%, transparent) 50%,
      transparent 100%
    );
    opacity: var(--ctav2-scrim, 0.7);
  }

  .cta-banner-v2__inner {
    display: flex;
    /* Centred at both breakpoints, unlike v1. */
    align-items: center;
    padding-block: var(--space-xl);
  }

  .cta-banner-v2__content {
    display: flex;
    flex-direction: column;
    /* Left edge of the container, which is the same gutter every other band
       starts at. `width: 100%` would make no difference to a flex-start
       column, but it does let a filled text block wrap against the container
       rather than against the graphic's width. */
    align-items: flex-start;
    gap: var(--space-lg);
    width: 100%;
  }

  /* --- the graphic ------------------------------------------------------
     Width is the control, height follows. An SVG addressed by filename has no
     dimensions the storefront can read, so its box cannot be reserved — set
     the width you want and let the intrinsic ratio do the rest. */

  .cta-banner-v2__graphic {
    display: block;
    width: var(--ctav2-graphic-w-mobile, 24rem);
    max-width: 100%;
    height: auto;
  }

  /* --- optional copy ---------------------------------------------------- */

  .cta-banner-v2__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    width: 100%;
  }

  .cta-banner-v2__eyebrow {
    margin: 0;
    color: var(--brand-accent);
    font-family: var(--font-eyebrow);
    font-size: var(--text-xs);
    font-style: italic;
    font-weight: var(--weight-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .cta-banner-v2__heading {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    text-transform: uppercase;
  }

  .cta-banner-v2__body {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .cta-banner-v2__cta {
    margin-block-start: var(--space-2xs);
  }

  /* --- desktop ---------------------------------------------------------- */

  @media screen and (min-width: 990px) {
    .cta-banner-v2 {
      min-height: var(--ctav2-min-h, 35.2rem);
    }

    .cta-banner-v2__content {
      width: auto;
      max-width: 52rem;
    }

    .cta-banner-v2__graphic {
      width: var(--ctav2-graphic-w, 32rem);
    }

    .cta-banner-v2__eyebrow {
      font-size: var(--text-sm);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DRIP CTA banner v2",
  "tag": "section",
  "class": "drip-cta-banner-v2-section",
  "settings": [
    {
      "type": "header",
      "content": "Graphic"
    },
    {
      "type": "paragraph",
      "content": "Sits at the left edge of the container and centres vertically in the band. Use the file name below for an SVG — Shopify's image picker does not offer SVGs."
    },
    {
      "type": "text",
      "id": "graphic_file_name",
      "label": "Graphic file name",
      "info": "A file uploaded under Content > Files, e.g. drip-lockup.svg. Used when no image is picked below."
    },
    {
      "type": "image_picker",
      "id": "graphic_image",
      "label": "Graphic image",
      "info": "For a PNG or JPG. Takes precedence over the file name above, and gets a responsive srcset the file route cannot."
    },
    {
      "type": "text",
      "id": "graphic_alt",
      "label": "Graphic alt text",
      "info": "Leave blank if the graphic is decorative or repeats something the band already says. Fill it in if the graphic carries the message — with no text below it, this is the only thing a screen reader has."
    },
    {
      "type": "range",
      "id": "graphic_width_mobile",
      "min": 80,
      "max": 400,
      "step": 8,
      "unit": "px",
      "label": "Graphic width, mobile",
      "default": 240
    },
    {
      "type": "range",
      "id": "graphic_width",
      "min": 120,
      "max": 720,
      "step": 8,
      "unit": "px",
      "label": "Graphic width, desktop",
      "default": 320
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Recommended: 2600px wide or more. Falls back to the file named below if empty."
    },
    {
      "type": "text",
      "id": "fallback_image_name",
      "label": "Fallback file name",
      "info": "A file uploaded under Content > Files. Used only when no image is picked above.",
      "default": "photoshoot-1.jpg"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Darken behind graphic",
      "default": 70
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "min": 200,
      "max": 640,
      "step": 8,
      "unit": "px",
      "label": "Minimum height, mobile",
      "default": 320
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 240,
      "max": 720,
      "step": 8,
      "unit": "px",
      "label": "Minimum height, desktop",
      "default": 352
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "paragraph",
      "content": "All optional, and blank by default. Anything filled in stacks beneath the graphic."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Defaults to the all-products collection when empty."
    }
  ],
  "presets": [
    {
      "name": "DRIP CTA banner v2"
    }
  ]
}
{% endschema %}
