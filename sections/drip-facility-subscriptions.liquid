{%- comment -%}
  DRIP facility subscriptions.

  B2B pricing grid for clubs/facilities — bronze/silver/gold tiers, blocks so a
  merchant can add or reorder a plan without a theme edit. Card layout follows
  the pack-grid / testimonials pattern: flex row, full-width below 750px.

  Subscriptions are not on sale yet (no product/checkout behind these plans),
  so there is deliberately no CTA button per card — Hard rule "ask, don't
  guess" would otherwise have this ship a button that leads nowhere. Instead
  one shared `unavailable_message` renders under the grid. Swap it out for a
  real "Sign Up" button + product link once subscription products exist.
{%- endcomment -%}

<section
  id="subscriptions"
  class="facility-subs"
  style="
    --fs-bg: {{ section.settings.background }};
    --fs-pad-block: {{ section.settings.padding_block }}px;
    --fs-tone-strength: {{ section.settings.tier_tone_strength }}%;
  "
>
  <div class="drip-container">
    <div class="facility-subs__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="facility-subs__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="facility-subs__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="facility-subs__body">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="facility-subs__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign feature_items = block.settings.features | newline_to_br | split: '<br />' -%}
          <li
            class="facility-subs__card{% if block.settings.featured %} facility-subs__card--featured{% endif %}"
            {%- if block.settings.tier_tone != 'none' %} style="--fs-tone: var(--tier-{{ block.settings.tier_tone }});"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.featured and block.settings.featured_label != blank -%}
              <span class="facility-subs__badge">{{ block.settings.featured_label | escape }}</span>
            {%- endif -%}

            <div class="facility-subs__card-head">
              <span class="facility-subs__tier">{{ block.settings.tier_name | escape }}</span>
              <span class="facility-subs__dot" aria-hidden="true"></span>
            </div>

            {%- if block.settings.price != blank -%}
              <p class="facility-subs__price">
                <span class="facility-subs__price-amount">{{ block.settings.price | escape }}</span>
                {%- if block.settings.price_suffix != blank -%}
                  <span class="facility-subs__price-suffix">{{ block.settings.price_suffix | escape }}</span>
                {%- endif -%}
              </p>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="facility-subs__description">{{ block.settings.description | escape }}</p>
            {%- endif -%}

            {%- if block.settings.features != blank -%}
              <ul class="facility-subs__features" role="list">
                {%- for item in feature_items -%}
                  {%- assign item_text = item | strip -%}
                  {%- if item_text != blank -%}
                    <li class="facility-subs__feature">
                      {% render 'svg-icons', icon: 'check-circle', class: 'facility-subs__feature-icon' %}
                      <span>{{ item_text | escape }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.unavailable_message != blank -%}
      <p class="facility-subs__unavailable">{{ section.settings.unavailable_message | escape }}</p>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="facility-subs__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .facility-subs {
    padding-block: var(--fs-pad-block, var(--space-section));
    background-color: var(--fs-bg, var(--color-bg-alt));

    /* #subscriptions anchor target. The header is sticky, so without this the
       jump parks the section heading underneath it. Offset by the header plus
       a step of air so the eyebrow is not flush against it. */
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .facility-subs__intro {
    max-width: 64ch;
    margin: 0 auto var(--space-lg);
    text-align: center;
  }

  .facility-subs__eyebrow {
    margin: 0 0 var(--space-2xs);
    color: var(--brand-accent);
    font-family: var(--font-eyebrow);
    font-size: var(--text-xs);
    font-style: italic;
    font-weight: var(--weight-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .facility-subs__heading {
    margin: 0 0 var(--space-sm);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-heading);
    text-transform: uppercase;
  }

  .facility-subs__body {
    color: var(--color-text-muted);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .facility-subs__body > :first-child { margin-block-start: 0; }
  .facility-subs__body > :last-child { margin-block-end: 0; }

  /* --- card track --------------------------------------------------------- */

  .facility-subs__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--grid-gap-row) var(--grid-gap);
    margin: 0 0 var(--space-lg);
    padding: 0;
    list-style: none;
  }

  /* The tier wash. Mixed against `transparent` rather than the band colour so
     the card carries its own alpha and stays correct if the section
     background is ever changed. With no --fs-tone the mix resolves to
     transparent and the card is exactly as it was. */
  .facility-subs__card {
    position: relative;
    display: flex;
    flex: 0 0 100%;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    background-color: color-mix(
      in srgb,
      var(--fs-tone, transparent) var(--fs-tone-strength, 7%),
      transparent
    );
  }

  .facility-subs__card--featured {
    border-color: var(--brand-accent-dim);
  }

  .facility-subs__badge {
    position: absolute;
    inset-block-start: calc(var(--space-sm) * -0.5);
    inset-inline-start: var(--space-sm);
    padding: var(--space-unit) var(--space-2xs);
    background-color: var(--brand-accent);
    color: var(--color-text-on-light);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .facility-subs__card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .facility-subs__tier {
    color: var(--brand-accent);
    font-family: var(--font-eyebrow);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .facility-subs__dot {
    width: 1.2rem;
    height: 1.2rem;
    border-radius: var(--radius-pill);
    background-color: var(--brand-accent);
  }

  .facility-subs__price {
    margin: 0;
    color: var(--color-text);
  }

  /* Amount and suffix STACK rather than sitting on a shared baseline.

     Two reasons. The markup strips the whitespace between the two spans
     (whitespace-trimming conditional tags), so inline they form one unbreakable run with no line-break
     opportunity in it — at 990, where a third of the rail is at its narrowest,
     "$864.95 /quarter" ran 98px past the card padding and could not wrap. And
     a seven-character price with a word-length suffix has outgrown the
     baseline-aligned treatment that suited "$99 /mo" anyway.

     Stacking makes the fit deterministic: only the amount has to fit the card,
     and the amount is the thing being compared across the three plans. */
  .facility-subs__price-amount {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: var(--weight-display);
    line-height: 1;
  }

  .facility-subs__price-suffix {
    display: block;
    margin-block-start: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
  }

  .facility-subs__description {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .facility-subs__features {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
    padding: var(--space-2xs) 0 0;
    border-block-start: 1px solid var(--color-border);
    list-style: none;
  }

  .facility-subs__feature {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xs);
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .facility-subs__feature-icon {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    margin-block-start: 0.1rem;
    color: var(--brand-accent);
  }

  /* --- unavailable message -------------------------------------------------
     Stands in for the per-card CTA while subscriptions aren't purchasable —
     one shared line rather than three dead buttons. */

  .facility-subs__unavailable {
    max-width: 48ch;
    margin: 0 auto;
    padding: var(--space-sm) 0;
    border-block-start: 1px solid var(--color-border);
    color: var(--color-text);
    font-family: var(--font-eyebrow);
    font-size: var(--text-sm);
    font-style: italic;
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-tight);
    text-align: center;
  }

  .facility-subs__footnote {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    line-height: var(--leading-tight);
    text-align: center;
  }

  /* --- desktop ------------------------------------------------------------ */

  @media screen and (min-width: 750px) {
    .facility-subs__heading {
      font-size: var(--text-h1);
    }

    /* THREE cards across leave TWO gaps between them, not one. Subtracting a
       single --grid-gap made the row measure 100% + gap, so the third card
       wrapped to a line of its own at every width above 750. */
    .facility-subs__card {
      flex: 0 0 calc((100% - 2 * var(--grid-gap)) / 3);
      max-width: calc((100% - 2 * var(--grid-gap)) / 3);
    }

    /* --text-h1 steps up to 5.6rem at 750, but this band is where the cards
       are NARROWEST — a third of the rail is ~205px at 750, leaving ~155px of
       card content, and "$864.95" needs ~200px of that at 5.6rem. Held at
       3.2rem until 990, where --gutter widens and there is room again. */
    .facility-subs__price-amount {
      font-size: 3.2rem;
    }
  }

  @media screen and (min-width: 990px) {
    .facility-subs__heading {
      font-size: var(--text-h2);
    }

    /* NOT --text-h1 (5.6rem). 990 is the tightest DESKTOP width: --gutter
       jumps 4.8rem -> 8rem here, so a card is NARROWER at 990 (250px) than at
       989 (282px). "$864.95" needs ~245px at 5.6rem against 204px of content;
       4.4rem brings it to ~192px. Full display size returns at 1200 below. */
    .facility-subs__price-amount {
      font-size: 4.4rem;
    }
  }

  /* Card width grows with the rail while --gutter stays put above 990, so by
     1200 a card is 320px and the price can go back to the display size the
     design intends. This is the only place in the theme that breaks at 1200;
     it is a fit threshold for one string, not a layout change. */
  @media screen and (min-width: 1200px) {
    .facility-subs__price-amount {
      font-size: var(--text-h1);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DRIP subscriptions",
  "tag": "section",
  "class": "drip-facility-subscriptions-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "For Clubs & Facilities"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Facility Subscriptions"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Keep every court stocked year-round. Automatic ball deliveries, member perks, and priority support — one plan for your whole facility.</p>"
    },
    {
      "type": "header",
      "content": "Availability"
    },
    {
      "type": "text",
      "id": "unavailable_message",
      "label": "Unavailable message",
      "info": "Shown in place of a Sign Up button until subscriptions go on sale.",
      "default": "Facility subscriptions are not currently available for preorder."
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "info": "Leave blank to hide."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "tier_tone_strength",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "label": "Tier tint strength",
      "info": "How strongly the bronze/silver/gold wash reads behind each card. Kept low on purpose.",
      "default": 7
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#151114"
    },
    {
      "type": "range",
      "id": "padding_block",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Plan",
      "settings": [
        {
          "type": "text",
          "id": "tier_name",
          "label": "Plan name",
          "default": "Bronze"
        },
        {
          "type": "select",
          "id": "tier_tone",
          "label": "Tier tint",
          "info": "A very light wash behind the card. Strength is set once for the whole section.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "bronze", "label": "Bronze" },
            { "value": "silver", "label": "Silver" },
            { "value": "gold", "label": "Gold" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "info": "Include the currency symbol, e.g. $204.95.",
          "default": "$204.95"
        },
        {
          "type": "text",
          "id": "price_suffix",
          "label": "Price suffix",
          "default": "/quarter"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "For single-court clubs getting started."
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features",
          "info": "One per line.",
          "default": "150 balls / quarter\nAuto-delivery"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured plan",
          "default": false
        },
        {
          "type": "text",
          "id": "featured_label",
          "label": "Featured badge label",
          "default": "Most Popular"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DRIP subscriptions",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tier_name": "Bronze",
            "price": "$204.95",
            "price_suffix": "/quarter",
            "description": "For single-court clubs getting started.",
            "features": "150 balls / quarter\nAuto-delivery",
            "featured": false
          }
        },
        {
          "type": "tier",
          "settings": {
            "tier_name": "Silver",
            "price": "$334.95",
            "price_suffix": "/quarter",
            "description": "For growing multi-court facilities.",
            "features": "260 balls / quarter\nAuto-delivery",
            "featured": false
          }
        },
        {
          "type": "tier",
          "settings": {
            "tier_name": "Gold",
            "price": "$864.95",
            "price_suffix": "/quarter",
            "description": "For tournament venues and large clubs.",
            "features": "720 balls / quarter\nAuto-delivery",
            "featured": true,
            "featured_label": "Most Popular"
          }
        }
      ]
    }
  ]
}
{% endschema %}
