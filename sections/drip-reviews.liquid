{%- comment -%}
  DRIP reviews.

  Distinct from sections/drip-testimonials.liquid, which is the homepage's
  unboxed pull-quote band. This one is the PDP review block: a rating summary
  row with a "write a review" action, then boxed review cards carrying their
  own star rating and a verified-buyer attribution.

  ---------------------------------------------------------------------------
  THE PAGINATION DOTS ARE NOT BUILT

  The desktop mockup draws three dashes under the cards, which implies a
  paged carousel. A static mockup cannot show what that carousel does — how
  many pages, whether it autoplays, whether it swipes on mobile — and
  CLAUDE.md says not to invent behaviour a mockup cannot show. The cards
  therefore reflow 1 -> 3 and every review authored is visible. Say the word
  and this becomes a scroll-snap rail with real controls.

  ---------------------------------------------------------------------------
  Reviews are blocks, not app data. Nothing in the theme knows which reviews
  app this store will use, so the summary numbers fall back to settings and
  are overridden by the standard `reviews.rating` / `reviews.rating_count`
  metafields when an app has written them.
{%- endcomment -%}

{%- liquid
  assign rating = section.settings.rating_value
  if product.metafields.reviews.rating.value != blank
    assign rating = product.metafields.reviews.rating.value.rating | round: 1
  endif

  assign rating_count = section.settings.rating_count
  if product.metafields.reviews.rating_count.value != blank
    assign rating_count = product.metafields.reviews.rating_count.value
  endif

  assign rating_rounded = rating | times: 1.0 | round
-%}

<div
  class="reviews"
  style="
    --rv-bg: {{ section.settings.background }};
    --rv-card-bg: {{ section.settings.card_background }};
    --rv-pad-block: {{ section.settings.padding_block }}px;
    --rv-avatar: {{ section.settings.avatar_size }}px;
  "
>
  <div class="drip-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="reviews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <div class="reviews__summary">
      <p class="reviews__score">{{ rating }}</p>

      <span class="reviews__stars" role="img" aria-label="{{ rating }} out of 5 stars">
        {%- for i in (1..5) -%}
          {%- if i <= rating_rounded -%}
            {% render 'svg-icons', icon: 'star', class: 'reviews__star' %}
          {%- else -%}
            {% render 'svg-icons', icon: 'star-outline', class: 'reviews__star' %}
          {%- endif -%}
        {%- endfor -%}
      </span>

      {%- if rating_count != blank -%}
        <p class="reviews__count">{{ rating_count }} {{ section.settings.count_label | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a class="btn btn-ghost btn-sm reviews__cta" href="{{ section.settings.cta_link | default: '#' }}">
          {{ section.settings.cta_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="reviews__list" role="list">
        {%- for block in section.blocks -%}
          <li class="review" {{ block.shopify_attributes }}>
            <figure class="review__figure">
              {%- if block.settings.stars > 0 -%}
                <span class="review__stars" role="img" aria-label="{{ block.settings.stars }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.stars -%}
                      {% render 'svg-icons', icon: 'star', class: 'review__star' %}
                    {%- else -%}
                      {% render 'svg-icons', icon: 'star-outline', class: 'review__star' %}
                    {%- endif -%}
                  {%- endfor -%}
                </span>
              {%- endif -%}

              {%- if block.settings.headline != blank -%}
                <h3 class="review__headline">{{ block.settings.headline | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.quote != blank -%}
                <blockquote class="review__quote">{{ block.settings.quote | escape }}</blockquote>
              {%- endif -%}

              <figcaption class="review__person">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 200
                    | image_tag:
                      loading: 'lazy',
                      widths: '100, 150, 200',
                      sizes: '48px',
                      class: 'review__avatar',
                      alt: block.settings.name
                  }}
                {%- endif -%}

                <span class="review__meta">
                  {%- if block.settings.name != blank -%}
                    <span class="review__name">{{ block.settings.name | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.badge != blank -%}
                    <span class="review__badge">{{ block.settings.badge | escape }}</span>
                  {%- endif -%}
                </span>
              </figcaption>
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .reviews {
    padding-block: var(--rv-pad-block, var(--space-xl));
    background-color: var(--rv-bg, var(--color-bg));
  }

  .reviews__eyebrow {
    margin: 0 0 var(--space-xs);
    color: var(--brand-accent);
    font-family: var(--font-eyebrow);
    font-size: var(--text-xs);
    font-style: italic;
    font-weight: var(--weight-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  /* --- summary row ----------------------------------------------------- */

  .reviews__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-block-end: var(--space-md);
  }

  .reviews__score {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-display);
    line-height: 1;
  }

  .reviews__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--brand-accent);
  }

  .reviews__star {
    width: var(--space-sm);
    height: var(--space-sm);
  }

  .reviews__count {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }

  /* `auto` margin rather than a spacer: the button goes to the trailing edge
     on a wide row and simply wraps to the next line when there is no room. */
  .reviews__cta {
    margin-inline-start: auto;
  }

  /* --- cards ----------------------------------------------------------- */

  .reviews__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .review__figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    height: 100%;
    margin: 0;
    padding: var(--space-sm);
    background-color: var(--rv-card-bg, var(--color-bg-elevated));
  }

  .review__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--brand-accent);
  }

  .review__star {
    width: var(--space-xs);
    height: var(--space-xs);
  }

  .review__headline {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: var(--weight-regular);
    line-height: var(--leading-heading);
  }

  .review__quote {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  /* Pushes the attribution to the card foot so a short review and a long one
     still line their names up across the row. */
  .review__person {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: auto;
    padding-block-start: var(--space-xs);
  }

  .review__avatar {
    flex: none;
    width: var(--rv-avatar, 4rem);
    height: var(--rv-avatar, 4rem);
    border-radius: var(--radius-pill);
    object-fit: cover;
  }

  .review__meta {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .review__name {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .review__badge {
    color: var(--color-text-faint);
    font-family: var(--font-body);
    font-size: var(--text-xs);
  }

  @media screen and (min-width: 750px) {
    .reviews__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-sm);
    }
  }

  @media screen and (min-width: 990px) {
    .reviews__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DRIP reviews",
  "tag": "section",
  "class": "drip-reviews-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trusted by players" },
    { "type": "header", "content": "Summary" },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating",
      "info": "Fallback only — the reviews.rating metafield wins when a reviews app has set it.",
      "default": "4.8"
    },
    { "type": "text", "id": "rating_count", "label": "Review count", "default": "620" },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "reviews" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Write a review" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "background", "label": "Background", "default": "#0B090C" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#151114" },
    {
      "type": "range",
      "id": "padding_block",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "avatar_size",
      "min": 32,
      "max": 88,
      "step": 4,
      "unit": "px",
      "label": "Avatar size",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        { "type": "text", "id": "headline", "label": "Headline", "default": "Consistent every time." },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review",
          "default": "The DRIP 48 is the most consistent ball I've played with. True flight, great bounce, and super durable."
        },
        { "type": "image_picker", "id": "image", "label": "Avatar" },
        { "type": "text", "id": "name", "label": "Name", "default": "Jordan W." },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Verified Buyer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DRIP reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "Consistent every time.",
            "quote": "The DRIP 48 is the most consistent ball I've played with. True flight, great bounce, and super durable.",
            "name": "Jordan W.",
            "badge": "Verified Buyer"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "Tournament ready.",
            "quote": "We use DRIP 48 in our league tournaments. It holds up and plays great indoors and outdoors.",
            "name": "Maya T.",
            "badge": "Verified Buyer"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "My go-to ball.",
            "quote": "Whether I'm training or just playing for fun, I grab DRIP. Quality you can feel on every shot.",
            "name": "Alex R.",
            "badge": "Verified Buyer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
