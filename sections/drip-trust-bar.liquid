{%- comment -%}
  DRIP trust bar.

  Two shapes, one markup. Desktop is the single elevated strip the mockup
  draws under the buy column — four items in a row, icon left of a two-line
  label. Mobile is the stacked list from the mobile mockup: full-width rows
  separated by hairlines, chevron at the trailing edge.

  THE CHEVRON ONLY APPEARS WHEN THE ROW ACTUALLY GOES SOMEWHERE. The mobile
  mockup draws one on every row, but a chevron that leads nowhere reads as a
  broken control, so each item carries a `link` setting and the chevron is
  conditional on it. Fill the four links in and mobile matches the mockup
  exactly; leave them blank and the rows render as plain statements.

  Type is flat across breakpoints — 12px title, 12px body — per hard rule 5.
{%- endcomment -%}

<div
  class="trustbar"
  style="
    --tb-bg: {{ section.settings.background }};
    --tb-item-bg: {{ section.settings.item_background }};
    --tb-pad-block: {{ section.settings.padding_block }}px;
  "
>
  <div class="drip-container">
    {%- if section.blocks.size > 0 -%}
      <ul class="trustbar__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign has_link = false -%}
          {%- if block.settings.link != blank -%}
            {%- assign has_link = true -%}
          {%- endif -%}

          <li class="trustbar__item" {{ block.shopify_attributes }}>
            {%- capture trustbar_content -%}
              <span class="trustbar__icon-wrap">
                {% render 'svg-icons', icon: block.settings.icon, class: 'trustbar__icon' %}
              </span>

              <span class="trustbar__text">
                {%- if block.settings.title != blank -%}
                  <span class="trustbar__title">{{ block.settings.title | escape }}</span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="trustbar__body">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </span>

              {%- if has_link -%}
                <span class="trustbar__chevron" aria-hidden="true">
                  {% render 'svg-icons', icon: 'chevron-right', class: 'trustbar__chevron-icon' %}
                </span>
              {%- endif -%}
            {%- endcapture -%}
            {%- if has_link -%}
              <a class="trustbar__row" href="{{ block.settings.link }}">{{ trustbar_content }}</a>
            {%- else -%}
              <div class="trustbar__row">{{ trustbar_content }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .trustbar {
    padding-block: var(--tb-pad-block, var(--space-md));
    background-color: var(--tb-bg, var(--color-bg));
  }

  .trustbar__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    /* The 1px gap plus a background on the list paints the hairlines between
       stacked mobile rows without a border on any single item — no doubled
       lines, no first/last-child exceptions. */
    background-color: var(--color-border);
  }

  .trustbar__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs);
    background-color: var(--tb-item-bg, var(--color-bg-alt));
    color: inherit;
    text-decoration: none;
  }

  .trustbar__row:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: calc(var(--focus-ring-offset) * -1);
  }

  .trustbar__icon-wrap {
    display: grid;
    place-items: center;
    color: var(--color-text);
  }

  .trustbar__icon {
    width: var(--space-md);
    height: var(--space-md);
  }

  .trustbar__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .trustbar__title {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .trustbar__body {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: var(--leading-tight);
  }

  .trustbar__chevron {
    display: grid;
    place-items: center;
    color: var(--color-text-faint);
  }

  .trustbar__chevron-icon {
    width: var(--space-sm);
    height: var(--space-sm);
  }

  @media (hover: hover) {
    a.trustbar__row:hover .trustbar__chevron {
      color: var(--brand-accent);
    }
  }

  /* ======================================================================
     Desktop — one strip, four across, no chevrons and no dividers
     ====================================================================== */

  @media screen and (min-width: 750px) {
    .trustbar__list {
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
      gap: 0;
      padding-block: var(--space-2xs);
      background-color: var(--tb-item-bg, var(--color-bg-alt));
    }

    .trustbar__row {
      justify-content: center;
      grid-template-columns: auto auto;
      padding-block: var(--space-xs);
    }

    .trustbar__chevron {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DRIP trust bar",
  "tag": "section",
  "class": "drip-trust-bar-section",
  "max_blocks": 6,
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#0B090C" },
    { "type": "color", "id": "item_background", "label": "Row background", "default": "#151114" },
    {
      "type": "range",
      "id": "padding_block",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "returns", "label": "Returns" },
            { "value": "lock", "label": "Lock" },
            { "value": "target", "label": "Target" },
            { "value": "shield-check", "label": "Shield" },
            { "value": "medal", "label": "Medal" },
            { "value": "trophy", "label": "Trophy" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On orders $150+" },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. The mobile chevron only appears on rows that link somewhere."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DRIP trust bar",
      "blocks": [
        {
          "type": "item",
          "settings": { "icon": "truck", "title": "Free shipping", "text": "On orders $150+" }
        },
        {
          "type": "item",
          "settings": { "icon": "returns", "title": "30-day returns", "text": "Hassle-free returns" }
        },
        {
          "type": "item",
          "settings": { "icon": "lock", "title": "Pay securely", "text": "Encrypted checkout" }
        },
        {
          "type": "item",
          "settings": { "icon": "target", "title": "Built to perform", "text": "Engineered for the game" }
        }
      ]
    }
  ],
  "enabled_on": { "templates": ["product", "index", "page", "collection"] }
}
{% endschema %}
